{
    "name": "vaiperui",
    "version": "1.0.0",
    "description": "React component library for Tailwind CSS: 44 accessible, typed components (forms with input masks, selects, date and time pickers, tables, overlays, toasts, media) with dark mode and a single customColor prop. Ships an agent skill; see also vaiperui-mcp.",
    "keywords": [
        "react",
        "react-components",
        "component-library",
        "ui-library",
        "design-system",
        "tailwindcss",
        "typescript",
        "input-mask",
        "accessibility",
        "dark-mode",
        "mcp",
        "agent-skill"
    ],
    "homepage": "https://vaiperui.vercel.app",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vaiperliotech/vaiperui.git",
        "directory": "packages/vaiperui"
    },
    "bugs": {
        "url": "https://github.com/vaiperliotech/vaiperui/issues"
    },
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "src/styles",
        "skills"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./theme.css": "./src/styles/theme.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "format": "biome format --write .",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@floating-ui/react-dom": "catalog:",
        "clsx": "catalog:",
        "tailwind-merge": "catalog:"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@storybook/react-vite": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vaiperui/config": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "jsdom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
