{
    "name": "vaiperui-monorepo",
    "version": "1.0.0-beta",
    "private": true,
    "description": "vaiperui monorepo: the React component library and its apps.",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@12.8.1",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.8.1",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "format": "biome format --write .",
        "format:check": "biome ci .",
        "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
        "clean": "turbo run clean"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@vaiperui/config": "catalog:",
        "turbo": "catalog:"
    }
}
